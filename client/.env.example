# ==============================================================================
# Client Environment Variables (Vite)
# ==============================================================================

# Backend Socket.IO Server URL
# Local development: http://localhost:5000
# Production on Render: https://<YOUR-RENDER-BACKEND-SERVICE>.onrender.com
VITE_SOCKET_URL=http://localhost:5000

# Backend REST API Base URL
# Local development: http://localhost:5000 (or leave empty to use Vite proxy /api)
# Production on Render: https://<YOUR-RENDER-BACKEND-SERVICE>.onrender.com
VITE_API_URL=http://localhost:5000
