# ==============================================================================
# Server Environment Variables
# ==============================================================================

# Server Port (Render automatically sets process.env.PORT)
PORT=5000

# Environment Mode
NODE_ENV=production

# Allowed Frontend Origins for CORS & Socket.IO
# Provide your deployed frontend URL on Render / Railway (e.g. https://your-site.onrender.com)
# Multiple origins can be comma-separated: https://your-site.onrender.com,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Optional alias for backward compatibility
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL for Drizzle ORM
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# Render provides this automatically when attaching a PostgreSQL instance.
# If omitted or unreachable, server operates in resilient in-memory fallback mode.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/youtube_watch_party
