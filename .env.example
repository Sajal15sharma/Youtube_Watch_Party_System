# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL for Drizzle ORM
# Replace YOUR_POSTGRES_PASSWORD with your local PostgreSQL password.
# Standard PostgreSQL defaults:
# - User: postgres
# - Host: localhost
# - Port: 5432
# - Database: youtube_watch_party
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/youtube_watch_party
