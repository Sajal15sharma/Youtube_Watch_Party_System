# ==============================================================================
# YouTube Watch Party - Environment Configuration Template
# ==============================================================================

# Server Port (Render sets process.env.PORT automatically)
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS & Socket.IO (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Client environment variables (Vite)
VITE_SOCKET_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000

# PostgreSQL Database Connection URL for Drizzle ORM
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# Render provides this via attached PostgreSQL instance.
# If omitted or unreachable, server operates in resilient in-memory fallback mode.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/youtube_watch_party
